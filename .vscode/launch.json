{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (.NET Core)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/src/EnterpriseUserManagement.Api/bin/Debug/net9.0/EnterpriseUserManagement.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/EnterpriseUserManagement.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Frontend (Browser)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start-frontend",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend/enterprise-user-management-ui"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": [
        "Backend (.NET Core)",
        "Frontend (Browser)"
      ],
      "stopAll": true
    }
  ]
}
